{
  "name": "bk-project-manager",
  "version": "0.2.1",
  "private": true,
  "description": "A local workspace for all your projects",
  "main": "electron/main.cjs",
  "author": "BK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/binbinku/BKProjectManager.git"
  },
  "homepage": "https://github.com/binbinku/BKProjectManager#readme",
  "bugs": {
    "url": "https://github.com/binbinku/BKProjectManager/issues"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "predev:renderer": "node scripts/prepare-native.cjs && node scripts/prepare-file-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "clean": "node scripts/clean.mjs",
    "clean:dist": "node scripts/clean.mjs dist",
    "clean:release": "node scripts/clean.mjs release",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:management": "node scripts/management-smoke.mjs",
    "test:removal": "node scripts/removal-smoke.mjs",
    "test:category": "node scripts/category-smoke.mjs",
    "test:palettes": "node scripts/palettes-smoke.mjs",
    "docs:screenshots": "npm run build && node scripts/prepare-native.cjs && node scripts/readme-screenshots.mjs && node scripts/workbench-smoke.mjs --docs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:generate": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/prepare-native.cjs",
    "predev": "node scripts/prepare-native.cjs && node scripts/prepare-file-icons.mjs",
    "prestart": "node scripts/prepare-native.cjs",
    "pretest:smoke": "node scripts/prepare-native.cjs",
    "test:workbench": "node scripts/workbench-smoke.mjs",
    "pretest:workbench": "node scripts/prepare-native.cjs",
    "prebuild": "node scripts/prepare-file-icons.mjs",
    "test:github": "node scripts/github-smoke.mjs",
    "test:windows": "node scripts/project-windows-smoke.mjs",
    "test:glass": "node scripts/glass-smoke.mjs",
    "pretest:markdown": "node scripts/prepare-native.cjs",
    "test:markdown": "node scripts/markdown-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@shikijs/core": "^4.5.0",
    "@shikijs/engine-javascript": "^4.5.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "material-icon-theme": "5.39.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.bk.projectmanager",
    "artifactName": "BKProjectManager-${version}-${os}-${arch}.${ext}",
    "productName": "BK Project Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "package.json",
      "build/*.png",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "dmg": {
      "icon": "build/icon.icns"
    },
    "beforePack": "./scripts/prepare-native.cjs",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
