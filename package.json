{
  "name": "bk-project-manager",
  "version": "0.1.0",
  "private": true,
  "description": "A local workspace for all your projects",
  "main": "electron/main.cjs",
  "author": "BK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/binbinku/BKProjectManager.git"
  },
  "homepage": "https://github.com/binbinku/BKProjectManager#readme",
  "bugs": {
    "url": "https://github.com/binbinku/BKProjectManager/issues"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/smoke.mjs",
    "docs:screenshots": "npm run build && node scripts/readme-screenshots.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.bk.projectmanager",
    "artifactName": "BKProjectManager-${version}-${os}-${arch}.${ext}",
    "productName": "BK Project Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
